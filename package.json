{
  "name": "ubet",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.functions.json && vite build",
    "dev:sync": "node ingest/server.mjs",
    "dev:api": "wrangler pages dev --port 8788",
    "db:migrate": "wrangler d1 migrations apply ubet --local",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --no-warnings --test shared/*.test.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.functions.json && tsc -p tsconfig.test.json",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:db",
    "test:db": "node --no-warnings --test tests/grade.test.mjs",
    "grade": "ingest\\.venv\\Scripts\\python ingest\\sync.py --grade-only",
    "test:integration": "node --no-warnings --test --test-concurrency=1 tests/integration/api.test.mjs"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.151.1"
  }
}
